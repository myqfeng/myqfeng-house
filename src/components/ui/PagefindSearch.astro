---
interface Props {
  id?: string;
  placeholder?: string;
}

const { id = 'search' } = Astro.props;
const triggerId = `search-trigger-${id}`;
const dialogId = `search-dialog-${id}`;
const inputId = `search-input-${id}`;
const closeId = `search-close-${id}`;
const statusId = `search-status-${id}`;
const resultsId = `search-results-${id}`;
---

<button id={triggerId} type="button" class="pagefind-trigger rounded-lg p-2" aria-label="搜索" aria-haspopup="dialog" aria-expanded="false">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8" />
    <path d="m21 21-4.3-4.3" />
  </svg>
</button>

<dialog id={dialogId} class="pagefind-dialog" aria-labelledby={`${dialogId}-title`}>
  <div class="pagefind-panel">
    <div class="pagefind-header">
      <h2 id={`${dialogId}-title`} class="text-lg font-semibold">搜索</h2>
      <button id={closeId} type="button" class="pagefind-close rounded-lg p-1" aria-label="关闭搜索">✕</button>
    </div>
    <div class="pagefind-inputwrap">
      <svg class="pagefind-inputicon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <input id={inputId} type="search" class="pagefind-input" placeholder="搜索文章、资源..." autocomplete="off" spellcheck="false" />
    </div>
    <div id={statusId} class="pagefind-status" role="status" aria-live="polite"></div>
    <div id={resultsId} class="pagefind-results"></div>
  </div>
</dialog>

<script is:inline define:vars={{ triggerId, dialogId, inputId, closeId, statusId, resultsId }}>
  (() => {
    const trigger = document.getElementById(triggerId);
    const dialog = document.getElementById(dialogId);
    const input = document.getElementById(inputId);
    const close = document.getElementById(closeId);
    const status = document.getElementById(statusId);
    const results = document.getElementById(resultsId);
    if (!trigger || !dialog || !input || !close || !status || !results) return;

    let pagefind = null;
    let debounceTimer = null;
    let searchSeq = 0;

    const loadPagefind = () => {
      if (pagefind) return Promise.resolve(pagefind);
      return import('/pagefind/pagefind.js').then((mod) => {
        pagefind = mod.default || mod;
        return pagefind;
      });
    };

    const escapeHtml = (str) =>
      str.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    const runSearch = async (query) => {
      const seq = ++searchSeq;
      status.textContent = '搜索中…';
      try {
        const pf = await loadPagefind();
        if (seq !== searchSeq) return;
        const { results: found } = await pf.search(query);
        if (seq !== searchSeq) return;
        const items = (
          await Promise.all(
            (found || []).slice(0, 10).map(async (item) => {
              try {
                return await item.data();
              } catch {
                return null;
              }
            })
          )
        ).filter(Boolean);
        if (items.length === 0) {
          status.textContent = '没有找到相关结果';
          results.innerHTML = '';
          return;
        }
        status.textContent = `找到 ${items.length} 个结果`;
        results.innerHTML = items
          .map((item) => {
            const title = escapeHtml(item.meta?.title || '未命名页面');
            const url = escapeHtml(item.url || '#');
            const excerpt = item.excerpt ? `<span class="pagefind-snippet">${item.excerpt}</span>` : '';
            return `<a class="pagefind-result" href="${url}"><span class="pagefind-result-title">${title}</span>${excerpt}</a>`;
          })
          .join('');
      } catch (err) {
        if (seq !== searchSeq) return;
        status.textContent = '搜索索引不可用，请先运行 pnpm build 构建站点';
        results.innerHTML = '';
      }
    };

    const onInput = () => {
      const query = input.value.trim();
      if (!query) {
        searchSeq++;
        status.textContent = '';
        results.innerHTML = '';
        return;
      }
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => runSearch(query), 250);
    };

    const openSearch = (initialQuery = '') => {
      dialog.showModal();
      trigger.setAttribute('aria-expanded', 'true');
      input.value = initialQuery;
      input.focus();
      if (initialQuery) {
        onInput();
      } else {
        searchSeq++;
        status.textContent = '';
        results.innerHTML = '';
      }
      loadPagefind().catch(() => {});
    };

    window.__openPagefindSearch = openSearch;
    trigger.addEventListener('click', () => openSearch());

    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      trigger.setAttribute('aria-expanded', 'false');
      clearTimeout(debounceTimer);
    });
    input.addEventListener('input', onInput);
  })();
</script>

<style is:global>
  .pagefind-trigger {
    color: var(--color-text-muted);
  }
  .pagefind-trigger:hover {
    color: var(--color-accent-hover);
    background-color: color-mix(in srgb, var(--color-text-muted) 15%, transparent);
  }

  .pagefind-dialog {
    width: min(90vw, 600px);
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--color-text-muted) 25%, transparent);
    border-radius: 1rem;
    background-color: var(--color-bg);
    color: var(--color-text);
    box-shadow: 0 20px 60px rgba(2, 6, 23, 0.4);
    overflow: hidden;
  }
  .pagefind-dialog::backdrop {
    background: rgba(2, 6, 23, 0.55);
    backdrop-filter: blur(4px);
  }

  .pagefind-panel {
    max-height: 70vh;
    overflow-y: auto;
    padding: 1rem;
  }

  .pagefind-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .pagefind-close {
    color: var(--color-text-muted);
  }
  .pagefind-close:hover {
    color: var(--color-text);
    background-color: color-mix(in srgb, var(--color-text-muted) 15%, transparent);
  }

  .pagefind-inputwrap {
    position: relative;
  }
  .pagefind-inputicon {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }
  .pagefind-input {
    width: 100%;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-text-muted) 30%, transparent);
    background-color: var(--color-bg);
    color: var(--color-text);
    padding: 0.625rem 1rem 0.625rem 2.5rem;
    outline: none;
  }
  .pagefind-input::placeholder {
    color: var(--color-text-muted);
  }
  .pagefind-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 20%, transparent);
  }
  .pagefind-input::-webkit-search-cancel-button {
    filter: opacity(0.6);
  }

  .pagefind-status {
    min-height: 1.5rem;
    padding: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .pagefind-results {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .pagefind-result {
    display: block;
    padding: 0.75rem;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }
  .pagefind-result:hover {
    border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
    background-color: color-mix(in srgb, var(--color-text-muted) 10%, transparent);
  }
  .pagefind-result-title {
    display: block;
    font-weight: 500;
    color: var(--color-accent-hover);
  }
  .pagefind-snippet {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  .pagefind-snippet mark {
    border-radius: 0.15rem;
    padding: 0 0.1rem;
    background-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: var(--color-text);
  }
</style>
