---
import { siteConfig } from '@/data/site';
import PagefindSearch from '@/components/ui/PagefindSearch.astro';
---

<header class="site-header sticky top-0 z-50 border-b backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4">
    <a href="/" class="site-brand flex items-center gap-2 text-xl font-bold hover:text-sky-glow">
      <svg class="h-6 w-6" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M20.7 15.2A8.5 8.5 0 0 1 8.8 3.3 8.5 8.5 0 1 0 20.7 15.2Z" />
      </svg>
      <span>{siteConfig.title}</span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {siteConfig.navLinks.map((link) => (
        <a href={link.url} class="site-nav-link text-sm font-medium transition hover:text-sky-glow">
          {link.name}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-1">
      <PagefindSearch />
      <button type="button" class="site-nav-link md:hidden" aria-label="菜单" aria-expanded="false" aria-controls="mobile-menu" id="mobile-menu-btn">
        <svg class="h-6 w-6" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="site-mobile-menu hidden border-t px-4 py-4 md:hidden" aria-hidden="true">
    {siteConfig.navLinks.map((link) => (
      <a href={link.url} class="site-nav-link block py-2 hover:text-sky-glow">
        {link.name}
      </a>
    ))}
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const setMenuState = (open) => {
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-hidden', String(!open));
    };
    btn.addEventListener('click', () => {
      setMenuState(menu.classList.contains('hidden'));
    });
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuState(false));
    });
  }
</script>

<style is:global>
  .site-header,
  .site-mobile-menu {
    border-color: color-mix(in srgb, var(--color-text-muted) 25%, transparent);
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
  }
  .site-brand,
  .site-nav-link {
    color: var(--color-text);
  }
  .site-nav-link {
    color: var(--color-text-muted);
  }
</style>
