---
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/config/site';
import PagefindSearch from '@/components/ui/PagefindSearch.astro';

const logo = siteConfig.navbar?.logo;
const repo = siteConfig.navbar?.repo;
const renderLogo = (() => {
  if (!logo) return null;
  if (logo.type === 'emoji') {
    return { html: `<span class="navbar-logo-emoji">${logo.value}</span>` };
  }
  if (logo.type === 'image') {
    return { html: `<img src="${logo.value}" alt="${logo.alt || ''}" class="navbar-logo-img" />` };
  }
  return { html: logo.value }; // icon：内联 SVG
})();
---

<header class="site-header sticky top-0 z-50 border-b backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4">
    <a href="/" class="site-brand flex items-center gap-2.5 text-2xl font-bold hover:text-sky-glow">
      {renderLogo && (
        <span class="navbar-logo flex h-8 w-8 items-center justify-center" set:html={renderLogo.html} />
      )}
      <span>{siteConfig.title}</span>
    </a>

    <div class="hidden items-center gap-9 md:flex">
      {siteConfig.navLinks.map((link) => (
        <a href={link.url} class="site-nav-link text-base font-medium transition hover:text-sky-glow">
          {link.name}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <PagefindSearch />
      {repo && (
        <a
          href={repo.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={repo.label ?? '项目源码'}
          title={repo.label ?? '项目源码'}
          class="flex h-9 w-9 items-center justify-center rounded-lg text-moon-400 transition hover:text-sky-glow hover:bg-moon-800/60 focus:outline-none focus:ring-2 focus:ring-sky-glow"
        >
          <Icon name={repo.icon ?? 'simple-icons:github'} class="h-5 w-5" aria-hidden="true" />
        </a>
      )}
      <button type="button" class="site-nav-link md:hidden" aria-label="菜单" aria-expanded="false" aria-controls="mobile-menu" id="mobile-menu-btn">
        <svg class="h-7 w-7" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="site-mobile-menu hidden border-t px-4 py-4 md:hidden" aria-hidden="true">
    {siteConfig.navLinks.map((link) => (
      <a href={link.url} class="site-nav-link block py-2 hover:text-sky-glow">
        {link.name}
      </a>
    ))}
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const setMenuState = (open) => {
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-hidden', String(!open));
    };
    btn.addEventListener('click', () => {
      setMenuState(menu.classList.contains('hidden'));
    });
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuState(false));
    });
  }
</script>

<style is:global>
  .site-header,
  .site-mobile-menu {
    border-color: color-mix(in srgb, var(--color-text-muted) 25%, transparent);
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
  }
  .site-brand,
  .site-nav-link {
    color: var(--color-text);
  }
  .site-nav-link {
    color: var(--color-text-muted);
  }
  .navbar-logo svg {
    width: 100%;
    height: 100%;
  }
  .navbar-logo-img {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
    border-radius: 0.3rem;
  }
  .navbar-logo-emoji {
    font-size: 1.7rem;
    line-height: 1;
  }
</style>
