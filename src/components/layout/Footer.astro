---
import { siteConfig } from '@/config/site';
import footerHtmlRaw from '@/config/footer.html?raw';

const footer = siteConfig.footer ?? {};
const socialLinks = siteConfig.socialLinks ?? [];
const copyright = footer.copyright
  ? `© ${new Date().getFullYear()} ${siteConfig.title}. ${footer.copyright}`
  : `© ${new Date().getFullYear()} ${siteConfig.title}`;

// 从 src/config/footer.html 读取自定义页脚 HTML（文件仅含注释/空白时不显示）
const withoutComments = footerHtmlRaw.replace(/<!--[\s\S]*?-->/g, '');
const footerHtml = withoutComments.trim();
---

<footer class="site-footer border-t py-8">
  <div class="mx-auto max-w-7xl px-4">
    {footer.links && footer.links.length > 0 && (
      <nav class="mb-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2" aria-label="页脚链接">
        {footer.links.map((link) => (
          <a href={link.url} class="text-sm text-[var(--color-text-muted)] transition hover:text-sky-glow">
            {link.label}
          </a>
        ))}
      </nav>
    )}

    {footerHtml && (
      <div class="mb-4 text-center text-sm text-[var(--color-text-muted)]" set:html={footerHtml} />
    )}

    {socialLinks.length > 0 && (
      <div class="mb-4 flex items-center justify-center gap-6">
        {socialLinks.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-sm text-[var(--color-text-muted)] transition hover:text-sky-glow">
            {link.label}
          </a>
        ))}
      </div>
    )}

    <p class="text-center text-sm text-[var(--color-text-muted)]">
      {copyright}
    </p>
  </div>
</footer>

<style is:global>
  .site-footer {
    border-color: color-mix(in srgb, var(--color-text-muted) 25%, transparent);
    background-color: color-mix(in srgb, var(--color-bg) 50%, transparent);
  }
</style>
