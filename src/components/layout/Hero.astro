---
import { siteConfig } from '@/config/site';
---

<section class="relative flex min-h-[60vh] flex-col items-center justify-center px-4 text-center">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_25%,rgba(147,197,253,0.14),transparent_28%),linear-gradient(180deg,rgba(15,23,42,0.1),rgba(2,6,23,0.72))]" aria-hidden="true"></div>
  <div class="relative z-10">
    <h1 class="mb-4 text-4xl font-bold tracking-tight text-moon-50 md:text-6xl">
      {siteConfig.title}
    </h1>
    <p class="mb-8 text-lg text-moon-300 md:text-xl">
      {siteConfig.subtitle}
    </p>
    <a href="/posts" class="inline-flex items-center gap-2 rounded-full bg-sky-bright px-6 py-3 font-medium text-moon-900 transition hover:bg-sky-glow focus:outline-none focus:ring-2 focus:ring-sky-glow focus:ring-offset-2 focus:ring-offset-moon-900">
      开始探索
      <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>
  </div>
</section>
