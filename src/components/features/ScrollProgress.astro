<div class="scroll-progress" data-scroll-progress aria-hidden="true">
  <span class="scroll-progress-bar" data-scroll-progress-bar></span>
</div>

<script is:inline data-astro-rerun>
  (() => {
    const bar = document.querySelector('[data-scroll-progress-bar]');
    if (!bar) return;

    let visible = false;
    const progress = document.querySelector('[data-scroll-progress]');

    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? window.scrollY / max : 0;
      bar.style.transform = `scaleX(${ratio})`;
      if (ratio > 0.004 && !visible) {
        visible = true;
        progress?.classList.add('visible');
      } else if (ratio <= 0.004 && visible) {
        visible = false;
        progress?.classList.remove('visible');
      }
    };

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

<style is:global>
  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 1500;
    background: rgba(148, 163, 184, 0.15);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .scroll-progress.visible {
    opacity: 1;
  }
  .scroll-progress-bar {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: 0 0;
    transform: scaleX(0);
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-hover));
    box-shadow: 0 0 8px rgba(96, 165, 250, 0.5);
  }
</style>
