---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import PostCard from '@/components/layout/PostCard.astro';
import { getResourceTypeById, resourceTypes } from '@/data/site';
import type { ResourceType } from '@/types';
import { getPostsByType } from '@/utils/content';

export const getStaticPaths = (async () => {
  return resourceTypes.map((type) => ({ params: { type: type.id }, props: { typeId: type.id } }));
}) satisfies GetStaticPaths;

const { typeId } = Astro.props;
const typeInfo = getResourceTypeById(typeId);
if (!typeInfo) {
  throw new Error(`Unknown resource type: ${typeId}`);
}

const posts = await getPostsByType(typeId as ResourceType);

const iconPaths: Record<string, string[]> = {
  'lucide:book-open': ['M12 7v14', 'M3 5.5A2.5 2.5 0 0 1 5.5 3H12v18H5.5A2.5 2.5 0 0 1 3 18.5z', 'M21 5.5A2.5 2.5 0 0 0 18.5 3H12v18h6.5a2.5 2.5 0 0 0 2.5-2.5z'],
  'lucide:wrench': ['M14.7 6.3a4 4 0 0 0-5 5L3 18l3 3 6.7-6.7a4 4 0 0 0 5-5l-2.9 2.9-3-3z'],
  'lucide:book': ['M4 19.5A2.5 2.5 0 0 1 6.5 17H20', 'M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2'],
  'lucide:play-circle': ['M10 8l6 4-6 4z', 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0'],
  'lucide:notebook': ['M6 4h11a2 2 0 0 1 2 2v14H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z', 'M8 2v4', 'M8 10h7', 'M8 14h7'],
  'lucide:code': ['M16 18l6-6-6-6', 'M8 6l-6 6 6 6'],
};
---

<BaseLayout title={typeInfo.name} description={typeInfo.description}>
  <section class="mx-auto max-w-7xl px-4 py-12">
    <div class="mb-8 flex items-center gap-3">
      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-sky-bright/10 text-sky-glow">
        <svg class="h-6 w-6" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          {(iconPaths[typeInfo.icon] ?? iconPaths['lucide:book-open']).map((path) => <path d={path} />)}
        </svg>
      </div>
      <div>
        <h1 class="text-3xl font-bold text-moon-50">{typeInfo.name}</h1>
        <p class="text-moon-300">{typeInfo.description}</p>
      </div>
    </div>

    {posts.length > 0 && (
      <div>
        <h2 class="mb-6 text-xl font-semibold text-moon-50">文章</h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    )}

    {posts.length === 0 && (
      <p class="text-moon-300">该分类下暂无文章。</p>
    )}
  </section>
</BaseLayout>
