---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { siteConfig } from '@/data/site';
---

<BaseLayout>
  <section class="flex min-h-[60vh] items-center justify-center px-4 font-sans">
    <main class="text-center">
      <h1 class="mb-4 text-4xl font-bold text-sky-bright">{siteConfig.title}</h1>
      <p class="text-moon-300">Astro 5 + Tailwind CSS 3 项目骨架已就绪</p>
    </main>
  </section>
</BaseLayout>
