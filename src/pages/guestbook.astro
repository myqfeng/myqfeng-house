---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import Comment from '@/components/comment/Comment.astro';
import { siteConfig } from '@/config/site';

const guestbookEntry = await getEntry('spec', 'guestbook');
const { Content } = await render(guestbookEntry!);
const title = guestbookEntry!.data.title || '留言板';
---

<BaseLayout title={title} description={`在 ${siteConfig.title} 留下你的足迹`}>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <PageHeader title={title} />
    <div class="glass-card p-8 prose prose-invert max-w-none">
      <Content />
    </div>
    <Comment customPath="/guestbook" />
  </section>
</BaseLayout>
