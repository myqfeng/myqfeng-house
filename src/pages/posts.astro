---
import BaseLayout from '@/components/layout/BaseLayout.astro';
---

<BaseLayout title="文章" description="文章与转载内容列表">
  <section class="mx-auto max-w-4xl px-4 py-16 text-center">
    <h1 class="mb-4 text-3xl font-bold text-moon-50">文章列表建设中</h1>
    <p class="text-moon-300">后续任务会在这里展示原创文章、转载文章、分类筛选和搜索。</p>
  </section>
</BaseLayout>
