---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import SearchBox from '@/components/ui/SearchBox.astro';
import Pagination from '@/components/ui/Pagination.astro';
import PostList from '@/components/widgets/PostList.astro';
import { postTypes, postConfig } from '@/config/postConfig';
import { siteConfig } from '@/config/site';
import { getPosts, getPostTypeCounts, getSubTypes, getTypeName } from '@/utils/content';

const posts = await getPosts();
const counts = await getPostTypeCounts();
const totalPages = Math.ceil(posts.length / postConfig.pageSize);
const subTypesByParent = getSubTypes(posts);

// 蛇形布局：左右两列按钮，左列从上到下、右列从下到上（S 形折返），
// 中间行的按钮最靠外、首尾行向中间收拢形成菱形轮廓；
// 单数分类时短列按钮组垂直居中；每个按钮用细线连到中间"所有文章"按钮
const BTN_SIZE = 152; // 按钮直径 9.5rem（px）
const COL_GAP = 16; // 相邻按钮垂直间距（px）
const EDGE_PAD = 16; // 容器上下内边距（px）
const WRAP_W = 1150; // 容器参考宽度（与 CSS 中 .radial-wrap 一致）
const LEFT_X = 11; // 中间行左列按钮中心 x（%）
const RIGHT_X = 89; // 中间行右列按钮中心 x（%）
const INNER_X = 26; // 首尾行按钮收拢后的 x（%）

const typeCount = postTypes.length;
const leftCount = Math.ceil(typeCount / 2);
const rightCount = typeCount - leftCount;
const WRAP_H = leftCount * BTN_SIZE + (leftCount - 1) * COL_GAP + EDGE_PAD * 2;
const middleY = WRAP_H / 2;
const halfH = (WRAP_H - EDGE_PAD * 2) / 2;

// 单列内按钮垂直分布：整组垂直居中（左列铺满时组中心即容器中心，短列自动居中）
const colYs = (count: number) => {
  const groupH = count * BTN_SIZE + (count - 1) * COL_GAP;
  const top = (WRAP_H - groupH) / 2;
  return Array.from({ length: count }, (_, i) => top + BTN_SIZE / 2 + i * (BTN_SIZE + COL_GAP));
};

// 水平收拢：距中间越远越靠内，中间行最外（菱形）
const rowX = (y: number, isLeft: boolean) => {
  const t = Math.min(Math.abs(y - middleY) / halfH, 1);
  return isLeft ? LEFT_X + (INNER_X - LEFT_X) * t : RIGHT_X + (100 - INNER_X - RIGHT_X) * t;
};

const leftYs = colYs(leftCount);
const rightYs = colYs(rightCount).reverse(); // 右列底到顶（蛇形折返）

const snakeButtons = postTypes.map((type, index) => {
  const isLeft = index < leftCount;
  const k = isLeft ? index : index - leftCount;
  const y = isLeft ? leftYs[k] : rightYs[k];
  return {
    ...type,
    px: rowX(y, isLeft).toFixed(2),
    py: ((y / WRAP_H) * 100).toFixed(2),
    delay: `${0.15 + index * 0.1}s`,
  };
});

// 连接线：每个分类按钮各自用一条细线连到中间"所有文章"按钮
const centerLines = snakeButtons
  .map(
    (b) =>
      `M ${WRAP_W / 2} ${WRAP_H / 2} L ${((parseFloat(b.px) / 100) * WRAP_W).toFixed(1)} ${((parseFloat(b.py) / 100) * WRAP_H).toFixed(1)}`,
  )
  .join(' ');
---

<BaseLayout title="文章" description="浏览所有原创文章和转载文章">
  <section class="mx-auto max-w-7xl px-4 py-12">
    <div class="radial-wrap" data-radial-nav style={`--wrap-h: ${WRAP_H}px`}>
      <svg
        class="radial-lines"
        viewBox={`0 0 ${WRAP_W} ${WRAP_H}`}
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          d={centerLines}
          fill="none"
          stroke="rgba(147, 197, 253, 0.22)"
          stroke-width="1.5"
          vector-effect="non-scaling-stroke"
        />
      </svg>
      <a href="/posts?type=all" class="radial-center">
        <span class="text-xl font-bold text-moon-900">所有文章</span>
        <span class="text-sm text-moon-700">共 {posts.length} 篇</span>
      </a>
      {snakeButtons.map((button) => (
        <a
          href={`/posts?type=${button.id}`}
          class="radial-btn glass-card"
          style={`--px: ${button.px}%; --py: ${button.py}%; --reveal-delay: ${button.delay}`}
        >
          <Icon name={button.icon} class="h-7 w-7 text-sky-glow" aria-hidden="true" />
          <span class="text-sm font-semibold text-moon-50">{button.name}</span>
          <span class="radial-btn-desc text-xs text-moon-300">{button.description}</span>
          <span class="text-xs text-moon-300">{counts[button.id] || 0} 篇</span>
        </a>
      ))}
    </div>

    <div class="hidden" data-posts-list>
      <PageHeader title="文章" />

      <nav class="reveal mb-6 hidden items-center gap-2 text-sm text-moon-400" data-crumb style="--reveal-delay: 0ms">
        <a href="/posts?type=all" class="hover:text-sky-glow" data-crumb-all>全部</a>
        <span aria-hidden="true">/</span>
        <a href="/posts?type=all" class="hover:text-sky-glow" data-crumb-parent></a>
        <span aria-hidden="true" data-crumb-sep>/</span>
        <span class="text-moon-200" data-crumb-current></span>
      </nav>

      <div class="reveal mb-6 flex flex-wrap gap-2" style="--reveal-delay: 0ms">
        <a href="/posts?type=all" data-type-filter="all" class="rounded-full bg-sky-bright px-4 py-1.5 text-base font-medium text-moon-900 transition">
          全部 ({posts.length})
        </a>
        {postTypes.map((type) => (
          <a href={`/posts?type=${type.id}`} data-type-filter={type.id} class="rounded-full bg-moon-800 px-4 py-1.5 text-base font-medium text-moon-200 transition hover:bg-moon-700">
            {type.name} ({counts[type.id] || 0})
          </a>
        ))}
      </div>

      <div class="mb-8">
        <SearchBox placeholder="搜索文章标题、描述或标签..." label="搜索文章" filter={false} />
      </div>

      <PostList posts={posts} />
      <p class="hidden py-12 text-center text-moon-300" data-empty-state>暂时没有符合条件的文章。</p>

      <Pagination currentPage={1} totalPages={totalPages} baseUrl="/posts" />
    </div>
  </section>
</BaseLayout>

<script
  is:inline
  data-astro-rerun
  data-page-size={postConfig.pageSize}
  data-valid-types={JSON.stringify([
    ...postTypes.map((type) => type.id),
    ...Object.values(subTypesByParent).flat().map((sub) => sub.type),
  ])}
  data-main-names={JSON.stringify(Object.fromEntries(postTypes.map((type) => [type.id, type.name])))}
>
  (() => {
    const script = document.currentScript;
    const pageSize = Number(script?.dataset.pageSize || '12');
    const validTypes = JSON.parse(script?.dataset.validTypes || '[]');
    const mainNames = JSON.parse(script?.dataset.mainNames || '{}');

    const currentParams = () => new URLSearchParams(window.location.search);

    const radialNav = document.querySelector('[data-radial-nav]');
    const postsList = document.querySelector('[data-posts-list]');
    const cards = Array.from(document.querySelectorAll('[data-searchable]'));
    const filters = Array.from(document.querySelectorAll('[data-type-filter]'));
    const input = document.getElementById('search');
    const pagination = document.querySelector('[data-pagination]');
    const emptyState = document.querySelector('[data-empty-state]');
    const crumb = document.querySelector('[data-crumb]');
    const crumbParent = document.querySelector('[data-crumb-parent]');
    const crumbSep = document.querySelector('[data-crumb-sep]');
    const crumbCurrent = document.querySelector('[data-crumb-current]');
    const activeClass = ['bg-sky-bright', 'text-moon-900'];
    const inactiveClass = ['bg-moon-800', 'text-moon-200', 'hover:bg-moon-700'];

    function applyMode() {
      const hasType = currentParams().has('type');
      radialNav?.classList.toggle('hidden', hasType);
      postsList?.classList.toggle('hidden', !hasType);
    }

    function pageHref(type, page) {
      const next = new URLSearchParams();
      next.set('type', type);
      if (page > 1) next.set('page', String(page));
      return `/posts?${next.toString()}`;
    }

    function renderPagination(type, currentPage, totalPages) {
      if (!pagination) return;
      pagination.classList.toggle('hidden', totalPages <= 1);
      pagination.innerHTML = '';
      if (totalPages <= 1) return;

      const pages = [];
      if (currentPage > 1) pages.push({ label: '上一页', page: currentPage - 1 });
      for (let page = 1; page <= totalPages; page += 1) pages.push({ label: String(page), page });
      if (currentPage < totalPages) pages.push({ label: '下一页', page: currentPage + 1 });

      pages.forEach(({ label, page }) => {
        const link = document.createElement('a');
        const isCurrent = page === currentPage && label === String(page);
        link.href = pageHref(type, page);
        link.textContent = label;
        link.className = `rounded-lg px-4 py-2 ${isCurrent ? 'bg-sky-bright text-moon-900' : 'bg-moon-800 text-moon-200 hover:bg-moon-700 hover:text-sky-glow'}`;
        if (isCurrent) link.setAttribute('aria-current', 'page');
        link.addEventListener('click', (event) => {
          event.preventDefault();
          navigateTo(link.href);
        });
        pagination.append(link);
      });
    }

    function updateCrumb(type, parentId) {
      if (!crumb) return;
      const isSubView = type.includes('/');
      crumb.classList.toggle('hidden', !isSubView);
      if (!isSubView) return;
      const parentName = mainNames[parentId] || parentId;
      crumbParent.textContent = parentName;
      crumbParent.href = `/posts?type=${parentId}`;
      crumbSep.classList.remove('hidden');
      crumbCurrent.textContent = decodeURIComponent(type.split('/')[1]);
    }

    function applyState() {
      const params = currentParams();
      const rawType = params.get('type') || 'all';
      const type = validTypes.includes(rawType) ? rawType : 'all';
      const isSubView = type.includes('/');
      const parentId = isSubView ? type.split('/')[0] : type;
      const hasAnySubs = cards.some((card) => card.hasAttribute('data-sub-card'));
      const search = input?.value.toLowerCase().trim() || '';

      const matchingCards = cards.filter((card) => {
        const cardType = card.getAttribute('data-type') || '';
        const isSubCard = card.hasAttribute('data-sub-card');
        let matchesType;
        if (type === 'all') matchesType = isSubCard ? hasAnySubs : !cardType.includes('/'); // 全部视图只列直属文章与子分类卡片
        else if (isSubView) matchesType = !isSubCard && cardType === type; // 子分类视图只列该子分类文章
        else if (isSubCard) matchesType = cardType.startsWith(`${type}/`); // 主分类视图显示其子分类卡片
        else matchesType = cardType === type; // 主分类视图只列直属文章
        const text = card.getAttribute('data-searchable')?.toLowerCase() || '';
        return matchesType && text.includes(search);
      });

      const totalPages = Math.ceil(matchingCards.length / pageSize);
      const requestedPage = Number.parseInt(params.get('page') || '1', 10);
      const currentPage = Math.min(Math.max(Number.isNaN(requestedPage) ? 1 : requestedPage, 1), Math.max(totalPages, 1));
      const firstIndex = (currentPage - 1) * pageSize;
      const visibleCards = new Set(matchingCards.slice(firstIndex, firstIndex + pageSize));

      cards.forEach((card) => card.classList.toggle('hidden', !visibleCards.has(card)));
      emptyState?.classList.toggle('hidden', matchingCards.length > 0);

      filters.forEach((filter) => {
        const isActive = filter.getAttribute('data-type-filter') === parentId;
        activeClass.forEach((className) => filter.classList.toggle(className, isActive));
        inactiveClass.forEach((className) => filter.classList.toggle(className, !isActive));
      });

      updateCrumb(type, parentId);
      renderPagination(type, currentPage, totalPages);
    }

    function navigateTo(href) {
      history.pushState({}, '', href);
      applyMode();
      applyState();
    }

    radialNav?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        navigateTo(link.getAttribute('href') || '/posts');
      });
    });

    filters.forEach((filter) => {
      filter.addEventListener('click', (event) => {
        event.preventDefault();
        navigateTo(pageHref(filter.getAttribute('data-type-filter') || 'all', 1));
      });
    });

    window.addEventListener('popstate', () => {
      applyMode();
      applyState();
    });

    input?.addEventListener('input', () => {
      const params = currentParams();
      params.delete('page');
      history.replaceState({}, '', `/posts?${params.toString()}`);
      applyState();
    });

    applyMode();
    applyState();
  })();
</script>

<style is:global>
  .page-header-title {
    font-size: 2.25rem;
  }
  @media (min-width: 768px) {
    .page-header-title {
      font-size: 3rem;
    }
  }

  .radial-wrap {
    position: relative;
    margin: 0 auto;
    height: var(--wrap-h, 780px);
    max-width: 1150px;
  }

  .radial-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .radial-center {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    border-radius: 9999px;
    background: var(--color-accent);
    color: #0f172a;
    padding: 1.5rem 3rem;
    box-shadow: 0 0 40px rgba(96, 165, 250, 0.4);
    animation-name: center-in;
    animation-duration: 0.8s;
    animation-timing-function: cubic-bezier(0.65, 0.05, 0, 1);
    animation-fill-mode: backwards;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .radial-center:hover {
    transform: translate(-50%, -50%) scale(1.05);
    box-shadow: 0 0 60px rgba(147, 197, 253, 0.55);
  }
  @keyframes center-in {
    from { transform: translate(-50%, -50%) scale(0); opacity: 0; }
    to { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  }

  .radial-btn {
    position: absolute;
    left: var(--px);
    top: var(--py);
    transform: translate(-50%, -50%);
    width: 9.5rem;
    height: 9.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    border-radius: 9999px;
    text-align: center;
    padding: 0.75rem;
    animation-name: radial-in;
    animation-duration: 0.7s;
    animation-timing-function: cubic-bezier(0.65, 0.05, 0, 1);
    animation-fill-mode: both;
    animation-delay: var(--reveal-delay, 0s);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .radial-btn-desc {
    line-height: 1.4;
    word-break: break-word;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .radial-btn:hover {
    transform: translate(-50%, -50%) translateY(-4px);
  }
  @keyframes radial-in {
    from { transform: translate(-50%, -50%) scale(0); opacity: 0; }
    to { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  }

  @media (max-width: 767px) {
    .radial-wrap {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      height: auto;
      max-width: 28rem;
    }
    .radial-wrap.hidden {
      display: none;
    }
    .radial-lines {
      display: none;
    }
    .radial-center {
      grid-column: span 2;
      position: static;
      transform: none;
      animation-name: fade-up;
      animation-delay: 0.05s;
    }
    .radial-center:hover {
      transform: scale(1.03);
    }
    .radial-btn {
      position: static;
      transform: none;
      width: auto;
      height: auto;
      border-radius: 1rem;
      padding: 1rem;
      animation-name: fade-up;
    }
    .radial-btn:hover {
      transform: translateY(-2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .radial-center,
    .radial-btn {
      animation: none;
      opacity: 1;
    }
    .radial-center,
    .radial-center:hover {
      transform: translate(-50%, -50%);
    }
    .radial-btn,
    .radial-btn:hover {
      transform: translate(-50%, -50%);
    }
  }

  @media (max-width: 767px) and (prefers-reduced-motion: reduce) {
    .radial-center,
    .radial-btn,
    .radial-center:hover,
    .radial-btn:hover {
      transform: none;
    }
  }
</style>
